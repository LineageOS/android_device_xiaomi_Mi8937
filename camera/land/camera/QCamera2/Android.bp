

cc_library_shared {
    name: "camera.land",
    compile_multilib: "32",
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-implicit-fallthrough",
        "-Wno-compound-token-split-by-macro",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-DCONFIG_MACH_XIAOMI_MSM8937",
        "-DCONFIG_MACH_XIAOMI_LAND",
        "-DHAS_MULTIMEDIA_HINTS",
        "-D_ANDROID",
        "-DUSE_MEDIA_EXTENSIONS",
        "-DUSE_DISPLAY_SERVICE",
        "-DDEFAULT_DENOISE_MODE_ON",
        "-DHAL3",
        "-DQCAMERA_REDEFINE_LOG",
        "-DTARGET_TS_MAKEUP",
        "-DVENUS_PRESENT",
    ],
    include_dirs: [
        "device/xiaomi/Mi8937/camera/land/camera/mm-image-codec/qexif",
        "device/xiaomi/Mi8937/camera/land/camera/mm-image-codec/qomx_core",
        "hardware/libhardware/include/hardware",
        "hardware/qcom-caf/msm8953/media/libstagefrighthw",
        "hardware/qcom-caf/msm8953/media/mm-core/inc",
        "system/core/libcutils/include/cutils",
        "system/core/libsystem/include/system",
        "system/media/camera/include/system",
        "system/memory/libion/kernel-headers",
        "system/memory/libion/include",
        "hardware/qcom-caf/msm8953/display/libqservice",
    ],
    local_include_dirs: [
        "stack/mm-camera-interface/inc",
        "util",
        "HAL3",
        "HAL",
        "HAL/tsMakeuplib/include",
    ],
    header_libs: [
        "generated_kernel_headers",
        "display_headers",
        "land_camera_common_headers",
        "media_plugin_headers",
        "libandroid_sensor_headers",
    ],

    relative_install_path: "hw",

    device_specific: true,

    shared_libs: [
        "liblog",
        "libhardware",
        "libutils",
        "libcutils",
        "libdl",
        "libsync",
        "libLmcamera_interface",
        "libLmjpeg_interface",
        "libui",
        "libcamera_metadata",
        "libqdMetaData",
        "libqservice",
        "libbinder",
        "libion",
        "android.frameworks.displayservice@1.0",
        "libhidlbase",

        "libts_face_beautify_hal",
        "libts_detected_face_hal",
    ],
    srcs: [
        "util/QCameraBufferMaps.cpp",
        "util/QCameraCmdThread.cpp",
        "util/QCameraFlash.cpp",
        "util/QCameraPerf.cpp",
        "util/QCameraQueue.cpp",
        "util/QCameraDisplay.cpp",
        "QCamera2Hal.cpp",
        "QCamera2Factory.cpp",
        "HAL3/QCamera3HWI.cpp",
        "HAL3/QCamera3Mem.cpp",
        "HAL3/QCamera3Stream.cpp",
        "HAL3/QCamera3Channel.cpp",
        "HAL3/QCamera3VendorTags.cpp",
        "HAL3/QCamera3PostProc.cpp",
        "HAL3/QCamera3CropRegionMapper.cpp",
        "HAL3/QCamera3StreamMem.cpp",
    ],
    static_libs: ["android.hardware.camera.common@1.0-helper"],
}

cc_library_headers {
    name: "land_camera_common_headers",
    installable: false,
    export_include_dirs: ["stack/common"],

}
