

cc_library_shared {
    name: "libWmjpeg_interface",
    compile_multilib: "32",
    cflags: [
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-DUSE_ION",
        "-DMM_JPEG_CONCURRENT_SESSIONS_COUNT=1",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-DODM_WINGTECH",
    ],
    include_dirs: [
        "system/memory/libion/kernel-headers",
        "system/memory/libion/include",
        "device/xiaomi/Mi8937/camera/mi8937/camera/QCamera2/stack/common",
        "device/xiaomi/Mi8937/camera/mi8937/camera/QCamera2/stack/mm-camera-interface/inc",
        "device/xiaomi/Mi8937/camera/mi8937/camera",
        "device/xiaomi/Mi8937/camera/mi8937/camera/mm-image-codec/qexif",
        "device/xiaomi/Mi8937/camera/mi8937/camera/mm-image-codec/qomx_core",
    ],
    local_include_dirs: ["inc"],
    header_libs: [
        "libutils_headers",
        "media_plugin_headers",
        "generated_kernel_headers",
    ],

    device_specific: true,

    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
        "libion",
        "libWmcamera_interface",
        "libWomx_core",
    ],
    srcs: [
        "src/mm_jpeg_queue.c",
        "src/mm_jpeg_exif.c",
        "src/mm_jpeg.c",
        "src/mm_jpeg_interface.c",
        "src/mm_jpeg_ionbuf.c",
        "src/mm_jpegdec_interface.c",
        "src/mm_jpegdec.c",
        "src/mm_jpeg_mpo_composer.c",
    ],
}

cc_library_shared {
    name: "libUmjpeg_interface",
    compile_multilib: "32",
    cflags: [
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-DUSE_ION",
        "-DMM_JPEG_CONCURRENT_SESSIONS_COUNT=1",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-DDEVICE_ULYSSE",
    ],
    include_dirs: [
        "system/memory/libion/kernel-headers",
        "system/memory/libion/include",
        "device/xiaomi/Mi8937/camera/mi8937/camera/QCamera2/stack/common",
        "device/xiaomi/Mi8937/camera/mi8937/camera/QCamera2/stack/mm-camera-interface/inc",
        "device/xiaomi/Mi8937/camera/mi8937/camera",
        "device/xiaomi/Mi8937/camera/mi8937/camera/mm-image-codec/qexif",
        "device/xiaomi/Mi8937/camera/mi8937/camera/mm-image-codec/qomx_core",
    ],
    local_include_dirs: ["inc"],
    header_libs: [
        "libutils_headers",
        "media_plugin_headers",
        "generated_kernel_headers",
    ],

    device_specific: true,

    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
        "libion",
        "libUmcamera_interface",
        "libUomx_core",
    ],
    srcs: [
        "src/mm_jpeg_queue.c",
        "src/mm_jpeg_exif.c",
        "src/mm_jpeg.c",
        "src/mm_jpeg_interface.c",
        "src/mm_jpeg_ionbuf.c",
        "src/mm_jpegdec_interface.c",
        "src/mm_jpegdec.c",
        "src/mm_jpeg_mpo_composer.c",
    ],
}
